# ===== LLM Configuration =====
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-v4-pro
TEMPERATURE=0.7
# MAX_TOKENS=4096

# ===== System =====
# DEBUG=false
# LOG_LEVEL=INFO
# SHOW_REACT_STEPS=true
# SHOW_PROGRESS=true

# ===== Agent =====
# AGENT_INTERACTIVE=true
# Read-only LS/Glob/Grep calls may run concurrently in consecutive batches.
# Write/Edit/Bash/Read/MCP/plugin tools remain serial; hooks disable parallelism.
# TOOL_PARALLEL_READS_ENABLED=true
# TOOL_MAX_CONCURRENCY=4

# ===== Optional local Web login (single operator only) =====
# Generate a random token, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Setting this enables HttpOnly session cookies, strict local Origin checks,
# CSRF protection for cookie-authenticated mutations, and WS handshake auth.
# No multi-user role isolation. Keep the API bound to 127.0.0.1.
# WEB_AUTH_TOKEN=

# ===== Experimental Docker tool sandbox =====
# Default is local_trusted: Bash and file tools access the HOST (not isolated).
# To opt in, pre-pull a Docker image and use a dedicated empty workspace.
# Docker mode exposes only container Bash; host file, MCP and team tools denied.
# AGENT_SANDBOX_MODE=local_trusted
# AGENT_SANDBOX_DOCKER_IMAGE=python:3.12-alpine
# AGENT_SANDBOX_MEMORY=512m
# AGENT_SANDBOX_CPUS=1.0
# AGENT_SANDBOX_PIDS_LIMIT=64

# ===== Context =====
# CONTEXT_WINDOW=128000
# COMPRESSION_THRESHOLD=0.8
# MIN_RETAIN_ROUNDS=10
# SUMMARY_TIMEOUT=120

# ===== Tool Output Truncation =====
# TOOL_OUTPUT_MAX_LINES=2000
# TOOL_OUTPUT_MAX_BYTES=51200
# TOOL_OUTPUT_TRUNCATE_DIRECTION=head
# TOOL_OUTPUT_HEAD_TAIL_LINES=40
# TOOL_OUTPUT_DIR=tool-output
# TOOL_OUTPUT_RETENTION_DAYS=7

# ===== Subagent =====
# SUBAGENT_MAX_STEPS=15
# LIGHT_LLM_MODEL_ID=deepseek-chat
# LIGHT_LLM_API_KEY=sk-xxx
# LIGHT_LLM_BASE_URL=https://api.deepseek.com
# LIGHT_LLM_PROVIDER=auto
# LIGHT_LLM_TEMPERATURE=0.5

# ===== Worktree =====
# WORKTREE_STORE_DIR=.worktrees
# WORKTREE_BASE_REF=fresh

# ===== Output Style =====
# Select the agent's response style: default, explanatory, learning
# AGENT_OUTPUT_STYLE=default

# ===== VCR (LLM API Recording/Replay for tests) =====
# VCR_ENABLED=false
# VCR_RECORD_MODE=new_episodes  # new_episodes | once | none
# VCR_FIXTURE_DIR=tests/fixtures/vcr

# ===== Hook System =====
# Configure lifecycle hooks in .mycode/hooks.json (project root).

# ===== Trace =====
# TRACE_ENABLED=true
# TRACE_DIR=memory/traces
# TRACE_SANITIZE=true

# ===== Optional remote observability (default OFF) =====
# Install optional SDKs first: pip install -r requirements-observability.txt
# Exported: span hierarchy, tool name/status, model name, token counts, timings.
# NEVER exported: prompt, response, tool inputs/outputs, file paths, secrets,
# or exception messages/stacks. Local JSONL trace is independent.
# AGENT_TELEMETRY_BACKEND=off             # off | langfuse | otlp
#
# Langfuse Python SDK v4 (native OpenTelemetry-backed observations).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
#
# OpenTelemetry Collector / compatible OTLP HTTP receiver.
# AGENT_TELEMETRY_BACKEND=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel-collector.example.com/v1/traces
# Authentication may be supplied using standard OpenTelemetry env settings.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20token
#
# ===== Optional Trace cost estimate (USD per 1 million tokens) =====
# Both must be set to enable estimates. These are operator-supplied rates,
# not live provider invoices. Use the actual model-specific rates.
# TRACE_INPUT_USD_PER_MILLION=
# TRACE_OUTPUT_USD_PER_MILLION=

# ===== MCP =====
# MCP_CONNECT_MODE=manual

# ===== Circuit Breaker =====
# CIRCUIT_FAILURE_THRESHOLD=3
# CIRCUIT_RECOVERY_TIMEOUT=300

# ===== Skills =====
# SKILLS_REFRESH_ON_CALL=true
# SKILLS_PROMPT_CHAR_BUDGET=12000

# ===== Background Task =====
# BG_TASK_OUTPUT_DIR=.tasks/output

# ===== AgentTeams =====
# ENABLE_AGENT_TEAMS=false
# AGENT_TEAMS_STORE_DIR=.teams
# AGENT_TASKS_STORE_DIR=.tasks
# TEAMMATE_MODE=auto            # auto | in-process | tmux
# TEAM_DELEGATE_MODE=false
# TEAM_WORKER_MAX_STEPS=8
# TEAM_LLM_MAX_CONCURRENCY=4
# TEAM_MAX_INBOX_SIZE=10000
# TEAM_MAX_WORK_ITEMS=5000

# ===== Model Profiles (for /model switching) =====
# Comma-separated list of profile names registered for /model <name>.
# Each profile needs MODEL_<NAME>_ID, plus optional _PROVIDER, _API_KEY, _BASE_URL.
# MODEL_PROFILES=deepseek,deepseek-chat
#
# # Profile: deepseek (main model)
# MODEL_DEEPSEEK_ID=deepseek-v4-pro
# MODEL_DEEPSEEK_PROVIDER=deepseek
# MODEL_DEEPSEEK_API_KEY=sk-xxx
# MODEL_DEEPSEEK_BASE_URL=https://api.deepseek.com
#
# # Profile: deepseek-chat (cheap, fast — for task/compact)
# MODEL_DEEPSEEK_CHAT_ID=deepseek-chat
# MODEL_DEEPSEEK_CHAT_PROVIDER=deepseek
# MODEL_DEEPSEEK_CHAT_API_KEY=sk-xxx
# MODEL_DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com

# ===== Model Pointers (automatic model selection by use-case) =====
# Each pointer refers to a profile name from MODEL_PROFILES.
# MODEL_POINTER_MAIN=deepseek
# MODEL_POINTER_TASK=deepseek-chat
# MODEL_POINTER_COMPACT=deepseek-chat
