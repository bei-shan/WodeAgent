# ============================================
# MyCodeAgent 环境变量配置模板
# 复制此文件为 .env 并填入你的实际配置
# ============================================

# ===== LLM 全局配置 (OpenAI-compatible) =====
# LLM 供应商: openai | deepseek | zhipu | dashscope | modelscope | kimi | moonshot | siliconflow | ollama | vllm
LLM_PROVIDER=siliconflow
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
LLM_MODEL_ID=Pro/moonshotai/Kimi-K2.5
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=2


# ===== 轻量模型配置 (用于子代理/Task) =====
LIGHT_LLM_PROVIDER=deepseek
LIGHT_LLM_API_KEY=your_light_api_key_here
LIGHT_LLM_BASE_URL=https://api.deepseek.com
LIGHT_LLM_MODEL_ID=deepseek-chat
# LIGHT_LLM_TEMPERATURE=0.5


# ===== Agent 运行配置 =====
# 调试模式: true | false
# DEBUG=false

# 日志级别: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# 是否显示 ReAct 步骤
# SHOW_REACT_STEPS=true

# 是否显示进度
# SHOW_PROGRESS=true

# 温度参数 (0.0 - 2.0)
# TEMPERATURE=0.7

# 最大输出 token 数
# MAX_TOKENS=

# 交互模式: true | false
# AGENT_INTERACTIVE=true


# ===== 上下文工程配置 =====
# 上下文窗口大小
CONTEXT_WINDOW=128000

# 压缩触发阈值 (0.0 - 1.0)
COMPRESSION_THRESHOLD=0.8

# 最少保留轮次数
MIN_RETAIN_ROUNDS=3

# Summary 生成超时（秒）
# SUMMARY_TIMEOUT=120


# ===== 工具输出截断配置 =====
# 截断方向: head | tail | head_tail
TOOL_OUTPUT_TRUNCATE_DIRECTION=head_tail

# 头尾保留行数
TOOL_OUTPUT_HEAD_TAIL_LINES=40

# 单次工具输出最大行数
# TOOL_OUTPUT_MAX_LINES=2000

# 单次工具输出最大字节数
# TOOL_OUTPUT_MAX_BYTES=51200

# 溢出输出落盘目录
# TOOL_OUTPUT_DIR=tool-output

# 溢出文件保留天数
# TOOL_OUTPUT_RETENTION_DAYS=7


# ===== MCP 工具配置 =====
# 连接模式: manual（后台连接）| startup（启动时连接）| disabled（禁用）
# MCP_CONNECT_MODE=manual

# 连接超时（秒，npx 首次下载需要 10-30s）
# MCP_CONNECT_TIMEOUT=30

# 单次工具调用超时（秒）
# MCP_CALL_TIMEOUT=30

# list_tools 超时（秒，首次 npx 下载可能更慢）
# MCP_LIST_TOOLS_TIMEOUT=60

# Context7 MCP API Key
CTX7_API_KEY=your_ctx7_api_key_here

# Tavily Search API Key
TAVILY_API_KEY=your_tavily_api_key_here


# ===== AgentTeams 多智能体配置 (实验性) =====
# 启用 AgentTeams: true | false
# ENABLE_AGENT_TEAMS=false

# Teammate 运行时模式: auto | in-process | tmux
# TEAMMATE_MODE=auto

# 委托模式: true | false
# TEAM_DELEGATE_MODE=false

# LLM 最大并发数
# TEAM_LLM_MAX_CONCURRENCY=4

# Worker 最大步数
# TEAM_WORKER_MAX_STEPS=8

# Team 存储目录
# AGENT_TEAMS_STORE_DIR=.teams

# Task 存储目录
# AGENT_TASKS_STORE_DIR=.tasks


# ===== 工具配置 =====
# 熔断器失败阈值（连续失败 N 次后禁用工具）
# CIRCUIT_FAILURE_THRESHOLD=3

# 熔断器恢复超时（秒）
# CIRCUIT_RECOVERY_TIMEOUT=300

# 允许网络工具 (curl/wget): true | false
# BASH_ALLOW_NETWORK=false

# SubAgent 最大步数
# SUBAGENT_MAX_STEPS=50


# ===== Skills 配置 =====
# 每次调用时刷新 Skill 缓存: true | false
# SKILLS_REFRESH_ON_CALL=true

# Skill 提示词字符预算
# SKILLS_PROMPT_CHAR_BUDGET=12000


# ===== Trace 日志配置 =====
# 启用 Trace: true | false
# TRACE_ENABLED=true

# Trace 文件目录
# TRACE_DIR=memory/traces

# 脱敏开关: true | false
# TRACE_SANITIZE=true


# ===== GitHub 配置 (可选) =====
# GITHUB_PAT_TOKEN=your_github_pat_here
